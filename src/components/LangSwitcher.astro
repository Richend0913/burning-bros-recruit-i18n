---
import { languages } from '../i18n/utils';
interface Props { t: any; lang: string; }
const { t, lang } = Astro.props;
const currentLang = languages.find(l => l.code === lang) || languages[0];
---

<div class="relative" id="lang-switcher">
  <button
    type="button"
    id="lang-toggle"
    class="flex items-center gap-2 px-3 py-2 text-sm text-[#f3ece0] border border-[#f3ece0]/20 hover:border-[#f3ece0]/50 transition-colors bg-transparent"
    aria-expanded="false"
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
    </svg>
    <span>{currentLang.name}</span>
    <svg class="w-3 h-3 transition-transform" id="lang-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <div
    id="lang-dropdown"
    class="hidden absolute right-0 top-full mt-1 bg-[#0a0906] border border-[#f3ece0]/20 min-w-[180px] z-50 shadow-xl"
  >
    {languages.map(l => (
      <a
        href={`/${l.code}/`}
        class:list={[
          'block px-4 py-2.5 text-sm transition-colors no-underline',
          l.code === lang
            ? 'text-[#ffc700] bg-[#f3ece0]/5'
            : 'text-[#f3ece0] hover:bg-[#f3ece0]/10'
        ]}
      >
        {l.name}
      </a>
    ))}
  </div>
</div>

<script>
  const toggle = document.getElementById('lang-toggle');
  const dropdown = document.getElementById('lang-dropdown');
  const chevron = document.getElementById('lang-chevron');

  toggle?.addEventListener('click', () => {
    const open = dropdown?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    chevron?.classList.toggle('rotate-180', open);
  });

  document.addEventListener('click', (e) => {
    const switcher = document.getElementById('lang-switcher');
    if (!switcher?.contains(e.target as Node)) {
      dropdown?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      chevron?.classList.remove('rotate-180');
    }
  });
</script>
