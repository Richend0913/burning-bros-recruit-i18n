---
interface Props { t: any; lang: string; }
const { t, lang } = Astro.props;
const df = t.daily_flow || {};
const steps = df.steps || [
  { time: '08:00', label: 'Morning', title: 'Pick up packages', desc: 'Load your vehicle at the delivery center.' },
  { time: '09:00', label: 'AM Route', title: 'Morning deliveries', desc: 'Deliver the first batch in your assigned area.' },
  { time: '12:00', label: 'Break', title: 'Lunch break', desc: 'Take a 1-hour break. Eat, rest, recharge.' },
  { time: '13:00', label: 'PM Route', title: 'Afternoon deliveries', desc: 'Continue with the afternoon batch.' },
  { time: '17:00', label: 'Last Mile', title: 'Evening deliveries', desc: 'Final deliveries and re-delivery attempts.' },
  { time: '20:00', label: 'Done', title: 'Finish for the day', desc: 'Return to center, scan returns, head home.' },
];
---

<section class="py-20 md:py-32 bg-[#0a0906] text-[#f3ece0] relative overflow-hidden">
  <div class="absolute pointer-events-none font-['Archivo_Black'] text-[200px] text-[#ff2d00]/[0.06] leading-none tracking-tighter" style="top: 40px; right: -60px;">DAILY ROUTE</div>

  <div class="max-w-5xl mx-auto px-4 md:px-7 relative z-10">
    <div class="inline-flex items-center gap-2.5 font-mono text-xs text-[#ffc700] tracking-widest mb-5">
      <span class="w-8 h-0.5 bg-[#ffc700]"></span>
      {df.tag || 'DAILY FLOW'}
    </div>
    <h2 class="font-['Archivo_Black'] text-3xl md:text-5xl text-[#f3ece0] leading-tight mb-14">
      {df.headline || 'A day in the life'}
    </h2>

    <div class="relative ml-4 md:ml-24">
      <!-- Timeline line -->
      <div class="absolute left-0 md:left-0 top-5 bottom-5 w-0.5" style="background: repeating-linear-gradient(to bottom, #ff2d00 0 8px, transparent 8px 14px);"></div>

      {steps.map((step: any) => (
        <div class="grid grid-cols-[80px_1fr] md:grid-cols-[100px_1fr] gap-8 md:gap-14 py-6 relative">
          <!-- Dot -->
          <div class="absolute left-[-5px] md:left-[-5px] top-8 w-3.5 h-3.5 bg-[#ff2d00] border-[3px] border-[#0a0906] rounded-full z-10"></div>

          <div class="pl-4">
            <div class="font-['Archivo_Black'] text-2xl md:text-3xl text-[#ffc700] leading-none">{step.time}</div>
            <div class="font-mono text-xs text-[#6b635a] mt-1">{step.label}</div>
          </div>
          <div class="pl-4 md:pl-10">
            <h3 class="text-xl md:text-2xl font-bold text-[#f3ece0] mb-2">{step.title}</h3>
            <p class="text-sm text-[#b8b0a4] max-w-md leading-7">{step.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
