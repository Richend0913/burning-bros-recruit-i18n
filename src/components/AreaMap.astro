---
interface Props { t: any; lang: string; }
const { t, lang } = Astro.props;
const am = t.areas || {};
const areas = am.list || [
  { region: 'TOKYO', name: 'Setagaya', tags: ['Setagaya', 'Yoga', 'Sangenjaya'], hot: true },
  { region: 'TOKYO', name: 'Ota', tags: ['Kamata', 'Omori', 'Haneda'], hot: false },
  { region: 'KANAGAWA', name: 'Yokohama', tags: ['Tsurumi', 'Kohoku', 'Kanagawa-ku'], hot: true },
  { region: 'KANAGAWA', name: 'Zama', tags: ['Zama', 'Ebina', 'Atsugi area'], hot: false },
];
---

<section class="py-20 md:py-32 bg-[#f3ece0]">
  <div class="max-w-5xl mx-auto px-4 md:px-7">
    <div class="inline-flex items-center gap-2.5 font-mono text-xs text-[#ff2d00] tracking-widest mb-5">
      <span class="w-8 h-0.5 bg-[#ff2d00]"></span>
      {am.tag || 'DELIVERY AREAS'}
    </div>
    <h2 class="font-['Archivo_Black'] text-3xl md:text-5xl leading-tight mb-14">
      {am.headline || 'Where you deliver'}
    </h2>

    <div class="grid sm:grid-cols-2 gap-4">
      {areas.map((area: any) => (
        <div class="border-2 border-[#0a0906] p-7 bg-[#f3ece0] hover:-translate-x-1 hover:-translate-y-1 transition-transform hover:shadow-[6px_6px_0_#ff2d00]">
          <div class="font-['Archivo_Black'] text-xs text-[#ff2d00] tracking-widest mb-2">{area.region}</div>
          <h3 class="text-2xl md:text-3xl font-bold mb-4">{area.name}</h3>
          <div class="flex flex-wrap gap-2">
            {area.tags.map((tag: string, i: number) => (
              <span class:list={[
                'px-3 py-1.5 text-sm font-bold',
                area.hot && i === 0
                  ? 'bg-[#ff2d00] text-[#f3ece0]'
                  : 'bg-[#0a0906] text-[#f3ece0]'
              ]}>
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
