---
interface Props { t: any; lang: string; }
const { t, lang } = Astro.props;
const hs = t.housing || {};
---

<section class="py-16 md:py-24 bg-[#ffc700] relative overflow-hidden">
  <div class="absolute inset-0 pointer-events-none" style="background-image: repeating-linear-gradient(45deg, transparent 0 60px, rgba(10,9,6,0.04) 60px 61px);"></div>

  <div class="max-w-5xl mx-auto px-4 md:px-7 relative z-10">
    <div class="flex items-start gap-4 md:gap-6">
      <!-- Icon -->
      <div class="flex-shrink-0 w-16 h-16 md:w-20 md:h-20 bg-[#0a0906] text-[#ffc700] flex items-center justify-center text-3xl md:text-4xl rounded-sm">
        &#127968;
      </div>

      <div>
        <div class="font-mono text-xs text-[#0a0906]/60 tracking-widest mb-2">{hs.tag || 'HOUSING SUPPORT'}</div>
        <h2 class="font-['Archivo_Black'] text-2xl md:text-4xl text-[#0a0906] leading-tight mb-4">
          {hs.headline || 'We sign the lease for you'}
        </h2>
        <p class="text-[#0a0906]/80 text-base md:text-lg leading-relaxed max-w-2xl">
          {hs.description || 'Finding an apartment as a foreigner in Japan is hard. We handle the lease contract as corporate guarantor so you can move in immediately.'}
        </p>

        <div class="mt-6 grid sm:grid-cols-3 gap-3">
          {(hs.points || [
            { icon: '&#128196;', text: 'Company-backed lease' },
            { icon: '&#128176;', text: 'Low initial cost' },
            { icon: '&#128205;', text: 'Near delivery areas' },
          ]).map((point: any) => (
            <div class="bg-[#0a0906] text-[#f3ece0] px-4 py-3 flex items-center gap-3 text-sm font-bold">
              <span class="text-xl" set:html={point.icon}></span>
              <span>{point.text}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
