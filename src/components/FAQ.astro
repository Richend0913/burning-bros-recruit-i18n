---
interface Props { t: any; lang: string; }
const { t, lang } = Astro.props;
const faq = t.faq || {};
const items = faq.items || [
  { q: 'Do I need a car?', a: 'We can help you lease a delivery van. No need to own one.' },
  { q: 'What about insurance?', a: 'Vehicle insurance and cargo insurance are arranged through us at competitive rates.' },
  { q: 'How soon can I start?', a: 'If your visa allows, you can start within 1-2 weeks after orientation.' },
  { q: 'Is there a minimum commitment?', a: 'No long-term contract. We ask for at least 3 months to learn the routes properly.' },
  { q: 'What if I get sick?', a: 'As an independent contractor, there is no paid sick leave, but we can adjust your schedule flexibly.' },
  { q: 'Can I choose my delivery area?', a: 'We match you to an area based on your location and availability. Preferences are considered.' },
  { q: 'Do I need a Japanese driver license?', a: 'Yes, a valid Japanese driver license (or international driving permit) is required.' },
  { q: 'What happens on rainy days?', a: 'Deliveries continue rain or shine. Package volume often increases on rainy days, meaning more earnings.' },
];
---

<section class="py-20 md:py-32 bg-[#f3ece0]">
  <div class="max-w-4xl mx-auto px-4 md:px-7">
    <div class="inline-flex items-center gap-2.5 font-mono text-xs text-[#ff2d00] tracking-widest mb-5">
      <span class="w-8 h-0.5 bg-[#ff2d00]"></span>
      {faq.tag || 'FAQ'}
    </div>
    <h2 class="font-['Archivo_Black'] text-3xl md:text-5xl leading-tight mb-14">
      {faq.headline || 'Questions & Answers'}
    </h2>

    <div class="faq-list">
      {items.map((item: any, i: number) => (
        <details class="faq-item border-b border-[#0a0906] py-7 cursor-pointer group" class:list={[i === 0 && 'border-t']}>
          <summary class="flex gap-5 items-baseline list-none [&::-webkit-details-marker]:hidden">
            <span class="font-['Archivo_Black'] text-2xl text-[#ff2d00] flex-shrink-0">Q</span>
            <span class="text-lg font-bold flex-1 leading-snug">{item.q}</span>
            <span class="font-mono text-sm text-[#6b635a] group-open:rotate-90 transition-transform flex-shrink-0">&#9654;</span>
          </summary>
          <div class="mt-4 ml-11 text-base text-[#2a2520] leading-8">
            <p>{item.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
