---
interface Props { t: any; lang: string; }
const { t, lang } = Astro.props;
const vc = t.visa || {};
---

<section class="py-20 md:py-32 bg-[#f3ece0]" id="visa-check">
  <div class="max-w-5xl mx-auto px-4 md:px-7">
    <div class="inline-flex items-center gap-2.5 font-mono text-xs text-[#ff2d00] tracking-widest mb-5">
      <span class="w-8 h-0.5 bg-[#ff2d00]"></span>
      {vc.tag || 'VISA CHECK'}
    </div>
    <h2 class="font-['Archivo_Black'] text-3xl md:text-5xl leading-tight mb-4">
      {vc.headline || 'Can I work with my visa?'}
    </h2>
    <p class="text-[#2a2520] text-base mb-10 max-w-xl">
      {vc.description || 'Tap your visa type to check eligibility.'}
    </p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3" id="visa-grid">
      {(vc.types || [
        { name: 'Permanent Resident', status: 'ok' },
        { name: 'Spouse of Japanese National', status: 'ok' },
        { name: 'Long-term Resident', status: 'ok' },
        { name: 'Designated Activities (46)', status: 'ok' },
        { name: 'Technical Intern Training', status: 'no' },
        { name: 'Student Visa', status: 'review' },
        { name: 'Specified Skilled Worker', status: 'review' },
        { name: 'Humanitarian / Refugee', status: 'ok' },
      ]).map((visa: any, i: number) => (
        <button
          type="button"
          class="visa-btn border-2 border-[#0a0906] px-5 py-4 text-left hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all bg-[#f3ece0] hover:shadow-[4px_4px_0_#ff2d00] cursor-pointer"
          data-status={visa.status}
          data-index={i}
        >
          <div class="font-bold text-base">{visa.name}</div>
          <div class="visa-result mt-2 text-sm font-mono hidden"></div>
        </button>
      ))}
    </div>

    <div class="mt-6 p-4 bg-[#e8dfcc] border-l-4 border-[#ffc700] text-sm text-[#2a2520]">
      {vc.note || 'Not sure about your visa? Contact us on LINE for a free check.'}
    </div>
  </div>
</section>

<script define:vars={{ okText: vc.result_ok || 'Eligible - You can start!', noText: vc.result_no || 'Not eligible for this work', reviewText: vc.result_review || 'May be eligible - Contact us' }}>
  document.querySelectorAll('.visa-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const status = btn.getAttribute('data-status');
      const result = btn.querySelector('.visa-result');
      if (!result) return;

      result.classList.remove('hidden');
      btn.classList.remove('bg-[#f3ece0]');

      if (status === 'ok') {
        result.textContent = okText;
        result.className = 'visa-result mt-2 text-sm font-mono text-green-700 font-bold';
        btn.classList.add('bg-green-50', 'border-green-600');
      } else if (status === 'no') {
        result.textContent = noText;
        result.className = 'visa-result mt-2 text-sm font-mono text-red-600 font-bold';
        btn.classList.add('bg-red-50', 'border-red-500');
      } else {
        result.textContent = reviewText;
        result.className = 'visa-result mt-2 text-sm font-mono text-amber-700 font-bold';
        btn.classList.add('bg-amber-50', 'border-amber-500');
      }
    });
  });
</script>
